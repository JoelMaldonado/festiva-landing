---
import CardGlass from "../ui/CardGlass.astro";
import InputField from "../ui/InputField.astro";
const repeatCount = 10;
const signupItems = Array.from({ length: repeatCount });
---

<div class="relative min-h-screen overflow-visible bg-darkB0">
  <!-- Círculos decorativos -->
  <img
    src="/images/circle_green_right.png"
    alt="Decoración"
    class="absolute -top-10 right-0 z-0"
  />

  <img
    src="/images/circle_orange_left.png"
    alt="Decoración"
    class="absolute left-0 z-0 bottom-40"
  />

  <section id="contact" class="relative z-10 max-w-6xl px-6 mx-auto">
    <div class="mb-12 text-center">
      <h1 class="text-3xl font-extrabold uppercase md:text-5xl">
        Are You a Club or Nightlife Venue?
        <span class="block mt-2 text-p1">Join Festiva</span>
      </h1>
      <p class="max-w-xl mx-auto mt-4 text-lg text-gray-300">
        Oslo’s top nightlife spots are already on <span
          class="font-semibold text-p1">Festiva</span
        >. Is yours?<br />
        You're missing out on visibility every night. Connect with us today.<br
        />
        <span class="font-bold text-p1"
          >This is your moment — don’t miss it.</span
        >
      </p>
    </div>

    <div class="flex flex-col items-center justify-center gap-10 md:flex-row">
      <div class="bg-[#1c1c1e] p-8 rounded-3xl w-full max-w-md shadow-lg">
        <h2 class="mb-6 text-xl font-semibold">Contact Form</h2>
        <p class="mb-6 text-gray-400">
          Become part of Norway’s new nightlife ecosystem.
        </p>
        <form id="contactForm" class="space-y-4" novalidate>
          <InputField
            id="name"
            label="Full Name"
            name="name"
            placeholder="Mark Andrade Mateo"
            value=""
          />
          <InputField
            id="email"
            label="Email Address"
            name="email"
            placeholder="example@mail.com"
            value=""
          />
          <InputField
            id="businessName"
            label="Business Name"
            name="business"
            placeholder="Aruba Disco"
            value=""
          />
          <InputField
            id="local"
            label="Venue Type"
            name="local"
            placeholder="Club, Bar, Restaurant"
            value=""
          />

          <!--
          <img class="w-72" src="/images/robot.png" alt="Robot">
          -->

          <!-- Botón con estado de carga -->
          <button
            id="btnSend"
            type="button"
            data-confetti-button
            class="w-full py-3 font-semibold text-white bg-p1 rounded-lg hover:bg-pink-600 transition disabled:opacity-70 disabled:cursor-not-allowed flex items-center justify-center gap-2"
          >
            <svg
              id="btnSpinner"
              class="animate-spin h-5 w-5 hidden"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle
                class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="4"
                fill="none"></circle>
              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 0 1 8-8v4A4 4 0 0 0 8 12H4z"></path>
            </svg>
            <span id="btnLabel">Send Message</span>
          </button>

          <!-- Mensaje de estado (éxito / error) con animación -->
          <div
            id="formStatus"
            class="hidden rounded-xl border px-4 py-3 text-sm mt-3 aria-[busy=true]:opacity-80 transition-all duration-300"
            role="status"
            aria-live="polite"
          >
          </div>
        </form>
      </div>

      <!-- Imagen del celular (mockup) -->
      <div>
        <img
          src="/images/mockup-events.webp"
          alt="Mockup app Festiva"
          class="max-w-[300px] rounded-xl"
        />
      </div>
    </div>
  </section>

  <div class="relative z-20 w-full">
    <div class="bg-p1 text-white py-3 sm:py-4 transform -skew-y-3">
      <div class="overflow-hidden">
        <div
          class="animate-marquee flex gap-6 px-6 sm:px-8 skew-y-3 text-base sm:text-xl font-semibold"
        >
          {
            signupItems.map((_, i) => (
              <div class="flex items-center gap-2 sm:gap-3 shrink-0">
                <span class="inline-block">JOIN NOW</span>
                <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 bg-white rounded-full" />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>

<script type="module" is:inline>
  const btnSend = document.getElementById("btnSend");
  const btnLabel = document.getElementById("btnLabel");
  const btnSpinner = document.getElementById("btnSpinner");
  const form = document.getElementById("contactForm");

  const nameInput = document.getElementById("name");
  const emailInput = document.getElementById("email");
  const businessInput = document.getElementById("businessName");
  const localInput = document.getElementById("local");

  const statusBox = document.getElementById("formStatus");

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function setLoading(isLoading) {
    btnSend.disabled = isLoading;
    btnSpinner.classList.toggle("hidden", !isLoading);
    btnLabel.textContent = isLoading ? "Sending..." : "Send Message";
    statusBox.setAttribute("aria-busy", isLoading ? "true" : "false");
  }

  function showStatus(type, message) {
    // type: 'success' | 'error' | 'info'
    const base =
      "rounded-xl px-4 py-3 text-sm mt-3 transition-all duration-300";
    const palette = {
      success:
        "border border-green-500/30 bg-green-500/10 text-green-300 shadow-[0_0_0_1px_rgba(34,197,94,0.15)]",
      error:
        "border border-red-500/30 bg-red-500/10 text-red-300 shadow-[0_0_0_1px_rgba(239,68,68,0.15)]",
      info: "border border-blue-500/30 bg-blue-500/10 text-blue-300 shadow-[0_0_0_1px_rgba(59,130,246,0.15)]",
    };

    statusBox.className = `${base} ${palette[type]}`;
    statusBox.textContent = message;
    statusBox.classList.remove("hidden", "opacity-0", "-translate-y-2");
    statusBox.classList.add("opacity-100", "translate-y-0");

    // Ocultar suave después de 4s (solo en éxito/info)
    if (type !== "error") {
      setTimeout(() => {
        statusBox.classList.add("opacity-0", "-translate-y-2");
        setTimeout(() => {
          statusBox.classList.add("hidden");
        }, 250);
      }, 4000);
    }
  }

  function softValidate() {
    const missing = [];
    if (!nameInput.value.trim()) missing.push("Full Name");
    if (!emailInput.value.trim() || !EMAIL_RE.test(emailInput.value.trim()))
      missing.push("Valid Email");
    if (!businessInput.value.trim()) missing.push("Business Name");
    if (!localInput.value.trim()) missing.push("Venue Type");

    if (missing.length) {
      showStatus("error", `Please complete: ${missing.join(", ")}.`);
      return false;
    }
    return true;
  }

  function clearForm() {
    form.reset();
  }

  btnSend.addEventListener("click", async () => {
    if (!softValidate()) return;

    const formData = {
      name: nameInput.value.trim(),
      email: emailInput.value.trim(),
      clubName: businessInput.value.trim(),
      address: localInput.value.trim(),
    };

    setLoading(true);
    showStatus("info", "Sending your message…");

    try {
      const url = "https://api.festiva.no/general/api/mail/send";
      const response = await fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(formData),
      });

      if (!response.ok) {
        const text = await response.text().catch(() => "");
        throw new Error(
          `Server error ${response.status}${text ? `: ${text}` : ""}`,
        );
      }

      // opcional: leer body por si tu API manda algo
      // const data = await response.json();

      showStatus("success", "🎉 Message sent! We'll get back to you shortly.");

      // Limpia el formulario con un pequeño retraso para que se perciba el éxito
      setTimeout(() => {
        clearForm();
      }, 200);

      // (Opcional) lanzar confetti si tu script lo maneja vía data-confetti-button
    } catch (error) {
      console.error("Error enviando formulario:", error);
      showStatus(
        "error",
        "We couldn't send your message right now. Please try again in a moment.",
      );
    } finally {
      setLoading(false);
    }
  });
</script>
