---
const {
  id,
  label,
  value = "",
  name,
  placeholder = "",
  type = "text",
  maxlength = 50,
} = Astro.props;
---

<div class="w-full px-4 py-2 transition border rounded-xl border-grey1">
  <label for={name} class="block text-sm font-medium text-p1">
    {label}
  </label>
  <input
    type={type}
    id={id}
    name={name}
    value={value}
    placeholder={placeholder}
    maxlength={maxlength}
    class="w-full text-lg text-white bg-transparent border-none outline-none placeholder:text-gray-500"
    oninput="updateCounter(this)"
  />
  <div class="flex justify-end text-xs mt-1">
    <span id={`${id}-counter`} class="text-gray-400">0/{maxlength}</span>
  </div>
</div>

<script is:inline>
  // Hacerla global para que oninput la encuentre
  window.updateCounter = (input) => {
    const counter = document.getElementById(`${input.id}-counter`);
    const max = input.maxLength || 0;
    const len = input.value.length;
    if (counter) {
      counter.textContent = `${len}/${max}`;
      counter.classList.toggle("text-red-400", len >= max);
      counter.classList.toggle("text-gray-400", len < max);
    }
  };

  // Inicializa el contador en el primer render
  const el = document.getElementById(`${id}`);
  if (el) window.updateCounter(el);
</script>
