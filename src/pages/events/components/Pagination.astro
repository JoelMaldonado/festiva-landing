---
const { page, limit, total } = Astro.props as { page: number; limit: number; total: number };
const totalPages = Math.max(Math.ceil(total / limit), 1);

// util: construye href preservando limit
const makeHref = (p: number) => {
  const u = new URL(Astro.url);
  u.searchParams.set('page', String(p));
  u.searchParams.set('limit', String(limit));
  return u.pathname + u.search; // ruta relativa limpia
};

// Rango compacto (máx 5 números visibles)
const windowSize = 5;
const start = Math.max(1, page - Math.floor(windowSize / 2));
const end = Math.min(totalPages, start + windowSize - 1);
const pages = Array.from({ length: end - start + 1 }, (_, i) => start + i);
---

<nav class="flex items-center justify-center">
  <ul class="flex flex-wrap items-center gap-2 text-sm">
    <!-- Primera -->
    <li>
      <a
        href={makeHref(1)}
        class="inline-flex items-center rounded-lg border border-white/10 px-3 py-2 text-neutral-200 hover:bg-white/5 disabled:opacity-50"
        aria-disabled={page === 1}
      >« Primera</a>
    </li>

    <!-- Anterior -->
    <li>
      <a
        href={makeHref(Math.max(1, page - 1))}
        class="inline-flex items-center rounded-lg border border-white/10 px-3 py-2 text-neutral-200 hover:bg-white/5"
        aria-disabled={page === 1}
      >‹ Anterior</a>
    </li>

    <!-- Números -->
    {pages.map((p) => (
      <li>
        <a
          href={makeHref(p)}
          aria-current={p === page ? 'page' : undefined}
          class={`inline-flex items-center rounded-lg px-3 py-2 ring-1 ring-transparent
            ${p === page
              ? 'bg-pink-500 text-white ring-pink-400'
              : 'border border-white/10 text-neutral-200 hover:bg-white/5'}`}
        >
          {p}
        </a>
      </li>
    ))}

    <!-- Siguiente -->
    <li>
      <a
        href={makeHref(Math.min(totalPages, page + 1))}
        class="inline-flex items-center rounded-lg border border-white/10 px-3 py-2 text-neutral-200 hover:bg-white/5"
        aria-disabled={page === totalPages}
      >Siguiente ›</a>
    </li>

    <!-- Última -->
    <li>
      <a
        href={makeHref(totalPages)}
        class="inline-flex items-center rounded-lg border border-white/10 px-3 py-2 text-neutral-200 hover:bg-white/5"
        aria-disabled={page === totalPages}
      >Última »</a>
    </li>
  </ul>
</nav>
